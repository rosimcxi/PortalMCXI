# Zkopírujte do .env; tento vzor neobsahuje skutečné heslo ani osobní souřadnice.
DB_PASSWORD=

# PortalMCXI MorningInfo — soukromá runtime konfigurace, necommitovat skutečné hodnoty.
PORTAL_LOCATION_NAME=
PORTAL_LOCATION_LAT=
PORTAL_LOCATION_LON=
PORTAL_TIMEZONE=Europe/Prague

# Soukromý osobní profil pro ranní výpočty. Skutečnou hodnotu necommitovat.
PORTAL_BIRTH_DATE=
