    },
    "MACMAX": {
      "hard_max_registered_workers": 3,
      "reserved_cpus": 2,
      "assignment_mode": "DYNAMIC",
      "cost_class": "OWNED"
    },
    "MACBOOKM2": {
      "hard_max_registered_workers": 3,
      "reserved_cpus": 2,
      "assignment_mode": "DYNAMIC",
      "cost_class": "OWNED"
    },
    "ASUS": {
      "hard_max_registered_workers": 4,
      "reserved_cpus": 2,
      "assignment_mode": "DYNAMIC",
      "gpu_worker_exclusive": true,
      "cost_class": "OWNED"
    },
    "HPI7": {
      "hard_max_registered_workers": 2,
      "reserved_cpus": 2,
      "assignment_mode": "DYNAMIC",
      "cost_class": "OWNED"
    }
  },
  "safety": {
    "db_write_serialized": true,
    "no_blind_overcommit": true,
    "accepted": "HUMAN_ONLY",
    "tested_target": "REAL_EVIDENCE_ONLY"
  }
